<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TheMazeRPG.UI.Controls"
             xmlns:views="using:TheMazeRPG.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="TheMazeRPG.Views.GameView"
             Background="#000000">

    <Grid>
        <controls:GameCanvas x:Name="GameCanvas" />
        <views:StatsOverlay x:Name="StatsOverlay"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

        <!-- Death Overlay -->
        <controls:DeathOverlay x:Name="DeathOverlay"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

        <!-- Stats Button -->
        <Button x:Name="StatsButton"
                Content="Stats"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Padding="8,4"
                FontSize="12"
                Click="StatsButton_Click" />

        <!-- ESC Pause Menu (game is paused while visible) -->
        <Border x:Name="PauseMenuOverlay"
                IsVisible="False"
                Background="#C0000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#181818"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="30,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="10" MinWidth="220">
                    <TextBlock Text="PAUSED"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFCC00"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <Button x:Name="ResumeButton" Content="Resume"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="ResumeButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="SaveButton_Click"/>
                    <Button x:Name="SettingsButton" Content="Settings"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="QuitToMenuButton" Content="Quit to Main Menu"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="QuitToMenuButton_Click"/>
                    <Button x:Name="QuitToDesktopButton" Content="Quit to Desktop"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="QuitToDesktopButton_Click"/>
                    <TextBlock x:Name="SaveHintText"
                               FontSize="11"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="240"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Inventory / Hotbar assignment (game is paused while visible) -->
        <Border x:Name="InventoryOverlay"
                IsVisible="False"
                Background="#C0000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#181818"
                    BorderBrush="#FFCC00"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="24,20"
                    Width="560"
                    MaxHeight="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Equip Attacks &amp; Items"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFCC00"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Click an item to see its stats; use the ▸ / ◂ arrow to equip or remove it. [I] to close."
                               FontSize="11"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <Border DockPanel.Dock="Bottom" Background="#111111" BorderBrush="#333333" BorderThickness="1"
                            CornerRadius="3" Padding="10,6" Margin="0,12,0,0" MinHeight="56">
                        <TextBlock x:Name="ItemDetailsText" Text="Select an item to inspect it."
                                   FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                    </Border>
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Equipped (Hotbar)" FontSize="14" FontWeight="Bold" Foreground="#88AAFF"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                <StackPanel x:Name="EquippedPanel" Spacing="4"/>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Inventory" FontSize="14" FontWeight="Bold" Foreground="#88AAFF"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                <StackPanel x:Name="InventoryPanel" Spacing="4"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Loot window: body inventory (left) + player inventory (right); paused while open -->
        <Border x:Name="LootOverlay"
                IsVisible="False"
                Background="#C0000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#181818"
                    BorderBrush="#FFCC00"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="24,20"
                    Width="560"
                    MaxHeight="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock x:Name="LootTitle" DockPanel.Dock="Top"
                               Text="Loot"
                               FontSize="22" FontWeight="Bold" Foreground="#FFCC00"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Click an item to inspect it; use the ◂ / ▸ arrow (or double-click / drag) to transfer. [Esc] to close."
                               FontSize="11" Foreground="#888888"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,12,0,0">
                        <Button x:Name="LootAllButton" Content="Loot All" Padding="24,6" Click="LootAllButton_Click"/>
                        <Button Content="Close" Padding="24,6" Click="LootCloseButton_Click"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#111111" BorderBrush="#333333" BorderThickness="1"
                            CornerRadius="3" Padding="10,6" Margin="0,10,0,0" MinHeight="52">
                        <TextBlock x:Name="LootDetailsText" Text="Select an item to inspect it."
                                   FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                    </Border>
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Body" FontSize="14" FontWeight="Bold" Foreground="#88AAFF"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <StackPanel x:Name="BodyPanel" Spacing="4"/>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Your Inventory" FontSize="14" FontWeight="Bold" Foreground="#88AAFF"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <StackPanel x:Name="PlayerPanel" Spacing="4"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Right-click context menu: a full-screen transparent layer (click anywhere to dismiss)
             holding the menu itself, positioned at the click point by margin. -->
        <Border x:Name="ContextMenuOverlay"
                IsVisible="False"
                Background="#01000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerPressed="ContextBackdrop_PointerPressed">
            <Border x:Name="ContextMenuBox"
                    Background="#181818"
                    BorderBrush="#FFCC00"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <StackPanel x:Name="ContextMenuPanel" Spacing="2" MinWidth="120"/>
            </Border>
        </Border>

        <!-- Debug console: the backtick (`/~) key toggles it. Type a command (e.g. "addxp 1000",
             "additem sword 2", "moveplayer dungeon 4", "reset health") and press Enter; the result
             shows on the output line above the input. A leading '/' is optional. -->
        <Border x:Name="DebugConsoleOverlay"
                IsVisible="False"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#E6000000"
                BorderBrush="#FFCC00"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <StackPanel Spacing="4">
                <TextBlock x:Name="DebugConsoleOutput"
                           Text="Debug console — type 'help'. [`] closes."
                           FontSize="12"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="&gt;"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FFCC00"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="DebugConsoleInput"
                             Grid.Column="1"
                             FontSize="14"
                             Background="#111111"
                             Foreground="#DDDDDD"
                             BorderThickness="0"
                             Padding="4,2"
                             AcceptsReturn="False"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
