<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="TheMazeRPG.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="The Maze RPG"
        Width="900"
        Height="600"
        CanResize="True"
        Background="#000000"
        FontFamily="avares://TheMazeRPG/Assets/Fonts#Odderf Basic">

    <!-- The single application window: a shell whose content swaps between the title screen,
         character creation, and the game itself. Navigation never closes this window. -->
    <ContentControl x:Name="ViewHost"/>

</Window>
